<Project>
  <PropertyGroup>
    <!-- Copy this file to local.props, then update the three machine-specific paths. -->
    <Sts2Dir>PATH_TO_STEAM/steamapps/common/Slay the Spire 2</Sts2Dir>
    <Sts2DataDir>$(Sts2Dir)/SlayTheSpire2.app/Contents/Resources/data_sts2_macos_arm64</Sts2DataDir>
    <GodotExe>PATH_TO_GODOT/MegaDot.app/Contents/MacOS/Godot</GodotExe>

    <!-- Normal builds stay inside the repository. Deployment is an explicit step. -->
    <ModOutputDir>$(MSBuildProjectDirectory)/.deploy/HammerMod/</ModOutputDir>
    <RitsuLibDeployDir>$(MSBuildProjectDirectory)/.deploy/STS2-RitsuLib</RitsuLibDeployDir>
    <CopyModOnBuild>false</CopyModOnBuild>
    <RunPckExport>false</RunPckExport>
  </PropertyGroup>
</Project>
