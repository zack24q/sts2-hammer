<Project Sdk="Microsoft.NET.Sdk">
    <Import Project="../../local.props" Condition="Exists('../../local.props')" />

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <LangVersion>13.0</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <RollForward>Major</RollForward>
        <CopyModOnBuild>false</CopyModOnBuild>
        <RunPckExport>false</RunPckExport>
        <RitsuLibAutoCopy>false</RitsuLibAutoCopy>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Godot.SourceGenerators" Version="4.5.1"
                          ExcludeAssets="all" PrivateAssets="all" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
        <PackageReference Include="xunit" Version="2.9.3" />
        <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <Reference Include="0Harmony" HintPath="$(Sts2DataDir)/0Harmony.dll" Private="true" />
        <Reference Include="sts2" HintPath="$(Sts2DataDir)/sts2.dll" Private="true" />
        <Reference Include="Steamworks.NET" HintPath="$(Sts2DataDir)/Steamworks.NET.dll" Private="true" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../../HammerMod.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="Xunit" />
    </ItemGroup>

    <Target Name="RemoveGodotSourceGeneratorsFromTests"
            BeforeTargets="CoreCompile">
        <ItemGroup>
            <Analyzer Remove="$(NuGetPackageRoot)godot.sourcegenerators/4.5.1/analyzers/dotnet/cs/Godot.SourceGenerators.dll" />
        </ItemGroup>
    </Target>
</Project>
